<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified"
    targetNamespace="http://fgistp" xmlns:fgistp="http://fgistp"
    xmlns:xi="http://www.w3.org/2001/XInclude" xmlns:gml="http://www.opengis.net/gml">
    <xs:include schemaLocation="fgistp.xsd"/>
    <xs:import namespace="http://www.opengis.net/gml" schemaLocation="redefine.xsd"/>
    <xs:annotation>
        <xs:documentation>Схема территориального планирования Российской Федерации в области федерального транспорта (в части трубопроводного транспорта)</xs:documentation>
    </xs:annotation>
    <xs:element name="Doc.10602010100">
        <xs:annotation>
            <xs:documentation>Положение о территориальном планировании в области федерального транспорта (в части трубопроводного транспорта)</xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element name="FeatureCollection">
                    <xs:annotation>
                        <xs:documentation>Географические объекты</xs:documentation>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element ref="gml:FeatureCollection">
                                <xs:annotation>
                                    <xs:documentation>Набор географических объектов</xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="newElement"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="ObjectCollection">
                    <xs:annotation>
                        <xs:documentation>Сведения о видах, назначении и наименованиях планируемых для размещения объектов федерального значения, их основные характеристики, их местоположение</xs:documentation>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence maxOccurs="unbounded">
                            <xs:element name="Object">
                                <xs:annotation>
                                    <xs:documentation>Сведения о видах, назначении и наименованиях планируемых для размещения объектов</xs:documentation>
                                </xs:annotation>
                                <xs:complexType>
                                    <xs:complexContent>
                                        <xs:extension base="fgistp:Object">
                                            <xs:sequence>
                                                <xs:element name="ClassID">
                                                    <xs:simpleType>
                                                        <xs:union
                                                            memberTypes="fgistp:AdmBorder_CLASSID fgistp:AdmeMO_CLASSID fgistp:AdmeNP_CLASSID fgistp:AdmeRF_CLASSID fgistp:AdmeSRF_CLASSID fgistp:AirTransportObj_CLASSID fgistp:AutoService_CLASSID fgistp:CustomControl_CLASSID fgistp:ElectricLine_CLASSID fgistp:ElectricPowerStation_CLASSID fgistp:ElectricTransformer_CLASSID fgistp:EmergencyProtectionObj_CLASSID fgistp:EngProtectionObj_CLASSID fgistp:GasFacility_CLASSID fgistp:GasPipeline_CLASSID fgistp:HazardArea_CLASSID fgistp:Health_CLASSID fgistp:HydraulicStructures_CLASSID fgistp:Hydro_CLASSID fgistp:Manufacturing_CLASSID fgistp:OilFacility_CLASSID fgistp:OilPipeline_CLASSID fgistp:OtherObject_CLASSID fgistp:Pipeline_CLASSID fgistp:Prison_CLASSID fgistp:PublicTransportLine_CLASSID fgistp:PublicTransportObj_CLASSID fgistp:PublicTransportService_CLASSID fgistp:PublicTransportStops_CLASSID fgistp:RailwayFacility_CLASSID fgistp:RailwayLine_CLASSID fgistp:Road_CLASSID fgistp:ServiceFacility_CLASSID fgistp:SewerFacility_CLASSID fgistp:SewerPipeline_CLASSID fgistp:Social_CLASSID fgistp:Street_CLASSID fgistp:StreetV_CLASSID fgistp:TelecomFacility_CLASSID fgistp:TelecomNetworkLine_CLASSID fgistp:ThermalFacility_CLASSID fgistp:ThermalPipeline_CLASSID fgistp:TranspLogisticObj_CLASSID fgistp:TransportObj_CLASSID fgistp:WasteFacility_CLASSID fgistp:WaterFacility_CLASSID fgistp:WaterPipeline_CLASSID fgistp:WaterTransportObj_CLASSID fgistp:WaterWays_CLASSID"
                                                            > </xs:union>
                                                    </xs:simpleType>
                                                </xs:element>
                                            </xs:sequence>
                                        </xs:extension>
                                    </xs:complexContent>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element minOccurs="0" name="SpecialZoneCollection">
                    <xs:annotation>
                        <xs:documentation>Зоны с особыми условиями использования территорий</xs:documentation>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence maxOccurs="unbounded">
                            <xs:element name="SpecialZone">
                                <xs:annotation>
                                    <xs:documentation>Зона с особыми условиями использования территорий</xs:documentation>
                                </xs:annotation>
                                <xs:complexType>
                                    <xs:complexContent>
                                        <xs:extension base="fgistp:Zone">
                                            <xs:sequence>
                                                <xs:element name="ClassID">
                                                    <xs:annotation>
                                                        <xs:documentation>Классы объектов</xs:documentation>
                                                    </xs:annotation>
                                                    <xs:simpleType>
                                                        <xs:union
                                                            memberTypes="fgistp:EngSanitaryGapZone_CLASSID fgistp:EngProtectionZone_CLASSID fgistp:SanitaryProtectionZone_CLASSID fgistp:DrinkWaterProtectionZone_CLASSID fgistp:EngProtectionZone_CLASSID fgistp:EngSanitaryGapZone_CLASSID fgistp:NaturalRiskZone_CLASSID fgistp:OtherProtectionZone_CLASSID fgistp:OtherZone_CLASSID fgistp:ProtectionZone_CLASSID fgistp:TechnoRiskArea_CLASSID fgistp:TranspProtectionZone_CLASSID fgistp:TranspSanitaryGapZone_CLASSID fgistp:WaterProtectionZone_CLASSID">
                                                        </xs:union>
                                                    </xs:simpleType>
                                                </xs:element>
                                            </xs:sequence>
                                        </xs:extension>
                                    </xs:complexContent>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
            <xs:attribute name="id" type="xs:ID">
                <xs:annotation>
                    <xs:documentation>Идентификатор документа</xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>
</xs:schema>
