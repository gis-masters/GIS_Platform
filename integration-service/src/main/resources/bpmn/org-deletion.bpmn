  <bpmn:process id="DeleteOrganization" name="DeleteOrganization" isExecutable="true">
    <bpmn:startEvent id="StartEvent" name="Start">
      <bpmn:outgoing>Flow_toDeleteDB</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_toDeleteDB" name="delete DB" sourceRef="StartEvent" targetRef="Activity_deleteDB" />
    <bpmn:serviceTask id="Activity_deleteDB" name="DeleteDB" camunda:asyncBefore="true" camunda:delegateExpression="${deleteDbDelegate}">
      <bpmn:incoming>Flow_toDeleteDB</bpmn:incoming>
      <bpmn:outgoing>Flow_0hb98dm</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_1l4fugw" name="Clear geoserver" camunda:asyncBefore="true" camunda:delegateExpression="${clearGeoserverDelegate}">
      <bpmn:incoming>Flow_0hb98dm</bpmn:incoming>
      <bpmn:outgoing>Flow_19y2abj</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_19y2abj" name="checks" sourceRef="Activity_1l4fugw" targetRef="Activity_0fkpcx3" />
    <bpmn:serviceTask id="Activity_0fkpcx3" name="Check status" camunda:asyncBefore="true" camunda:delegateExpression="${checkResultDelegate}">
      <bpmn:incoming>Flow_19y2abj</bpmn:incoming>
      <bpmn:outgoing>Flow_0cthmxl</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0hb98dm" name="clear geoserver" sourceRef="Activity_deleteDB" targetRef="Activity_1l4fugw" />
    <bpmn:exclusiveGateway id="Gateway_1brvlpf">
      <bpmn:incoming>Flow_0cthmxl</bpmn:incoming>
      <bpmn:outgoing>Flow_0pxrwce</bpmn:outgoing>
      <bpmn:outgoing>Flow_0hkibvt</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0cthmxl" sourceRef="Activity_0fkpcx3" targetRef="Gateway_1brvlpf" />
    <bpmn:sequenceFlow id="Flow_0pxrwce" name="success" sourceRef="Gateway_1brvlpf" targetRef="Activity_1fnc772">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isDeleted == 'true'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0hkibvt" name="error" sourceRef="Gateway_1brvlpf" targetRef="Activity_1nfwttv">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isDeleted == 'false'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Activity_1nfwttv" name="Send error event" camunda:asyncBefore="true" camunda:delegateExpression="${sendEventDelegate}">
      <bpmn:incoming>Flow_0hkibvt</bpmn:incoming>
      <bpmn:outgoing>Flow_18wxysk</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_1fnc772" name="Send success event" camunda:asyncBefore="true" camunda:delegateExpression="${sendEventDelegate}">
      <bpmn:incoming>Flow_0pxrwce</bpmn:incoming>
      <bpmn:outgoing>Flow_0k6pzhr</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_1vifkta" name="End">
      <bpmn:incoming>Flow_0k6pzhr</bpmn:incoming>
      <bpmn:incoming>Flow_18wxysk</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0k6pzhr" name="end" sourceRef="Activity_1fnc772" targetRef="Event_1vifkta" />
    <bpmn:sequenceFlow id="Flow_18wxysk" sourceRef="Activity_1nfwttv" targetRef="Event_1vifkta" />
  </bpmn:process>
