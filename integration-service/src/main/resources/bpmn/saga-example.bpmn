    <bpmn:sequenceFlow id="SequenceFlow_17aeok3" sourceRef="ServiceTask_0sfz9g8" targetRef="ServiceTask_1q2tzzq" />
    <bpmn:endEvent id="EndEvent_1cl1uxg">
