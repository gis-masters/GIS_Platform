  <bpmn:process id="Sagagexample" name="SagaExample" isExecutable="true">
    <bpmn:startEvent id="StartProcess" name="Init deletion">
      <bpmn:outgoing>SequenceFlow_startProcess</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="SequenceFlow_startProcess" sourceRef="StartProcess" targetRef="Task_fiz_1" />
    <bpmn:transaction id="Task_fiz_1" name="Deletion task">
      <bpmn:incoming>SequenceFlow_startProcess</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_endProcess</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent" name="Start event">
        <bpmn:outgoing>SequenceFlow_109d84b</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Task_1mwouuh" name="Списать с 1" camunda:asyncBefore="true" camunda:delegateExpression="${changeBalanceDelegate}">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="accountId">1</camunda:inputParameter>
            <camunda:inputParameter name="operation">-</camunda:inputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
        <bpmn:incoming>SequenceFlow_109d84b</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_1d6sjod</bpmn:outgoing>
