  <bpmn:process id="exportGpkgRaster" name="Export Gpkg Raster" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_07jq2fs</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_09qpsbc" name="with geoserver work" camunda:delegateExpression="${askGeoserverRasterLayersPath}">
      <bpmn:documentation>try to find layers paths list</bpmn:documentation>
      <bpmn:incoming>Flow_1lff233</bpmn:incoming>
      <bpmn:outgoing>Flow_1mvg4lx</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_07jq2fs" sourceRef="StartEvent_1" targetRef="Activity_1ed3eco" />
    <bpmn:endEvent id="Event_0kfqdf4" name="End">
      <bpmn:incoming>Flow_1stb6kk</bpmn:incoming>
      <bpmn:incoming>Flow_09bwjkb</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1mvg4lx" sourceRef="Activity_09qpsbc" targetRef="Gateway_0drqcrm" />
    <bpmn:serviceTask id="Activity_0jisndd" name="wrapper make tiles" camunda:delegateExpression="${askWrapperExportRasters}">
      <bpmn:incoming>Flow_0kv49tn</bpmn:incoming>
      <bpmn:outgoing>Flow_02pwcg2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_02pwcg2" sourceRef="Activity_0jisndd" targetRef="Activity_143gui8" />
    <bpmn:receiveTask id="Activity_143gui8" name="catch rasters worker event" messageRef="Message_2rvkafe">
      <bpmn:incoming>Flow_02pwcg2</bpmn:incoming>
      <bpmn:outgoing>Flow_0dn8rra</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sequenceFlow id="Flow_0dn8rra" sourceRef="Activity_143gui8" targetRef="Activity_1d235kx" />
    <bpmn:serviceTask id="Activity_1gc4yf2" name="Finalize Raster Export" camunda:delegateExpression="${finalizeRasterExport}">
      <bpmn:incoming>Flow_1hcc4in</bpmn:incoming>
      <bpmn:incoming>Flow_1rdecav</bpmn:incoming>
      <bpmn:incoming>Flow_1qjzaqq</bpmn:incoming>
