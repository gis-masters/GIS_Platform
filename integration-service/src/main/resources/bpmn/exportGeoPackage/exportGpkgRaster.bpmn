    <bpmn:sequenceFlow id="Flow_1stb6kk" sourceRef="Activity_1gc4yf2" targetRef="Event_0kfqdf4" />
    <bpmn:serviceTask id="Activity_1ed3eco" name="ack data service role" camunda:delegateExpression="${askDocumentAvailability}">
      <bpmn:incoming>Flow_07jq2fs</bpmn:incoming>
      <bpmn:outgoing>Flow_089pyhh</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_089pyhh" sourceRef="Activity_1ed3eco" targetRef="Gateway_1j80cmr" />
    <bpmn:exclusiveGateway id="Gateway_1j80cmr">
      <bpmn:incoming>Flow_089pyhh</bpmn:incoming>
      <bpmn:outgoing>Flow_1lff233</bpmn:outgoing>
      <bpmn:outgoing>Flow_1hcc4in</bpmn:outgoing>
      <bpmn:outgoing>Flow_09bwjkb</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1lff233" sourceRef="Gateway_1j80cmr" targetRef="Activity_09qpsbc">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${checkStatus == 'someResourcesAvailable'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1hcc4in" sourceRef="Gateway_1j80cmr" targetRef="Activity_1gc4yf2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${checkStatus == 'allResourcesUnavailable'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_0drqcrm">
      <bpmn:incoming>Flow_1mvg4lx</bpmn:incoming>
      <bpmn:outgoing>Flow_0kv49tn</bpmn:outgoing>
      <bpmn:outgoing>Flow_1rdecav</bpmn:outgoing>
