    <bpmn:sequenceFlow id="Flow_0cb7knp" sourceRef="Gateway_1g861nn" targetRef="Activity_1l1yjd4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${checkStatus == 'rasterGdalWorkDone'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_03vu3be" sourceRef="Gateway_1g861nn" targetRef="Activity_1gc4yf2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${checkStatus == 'rasterGdalWorkFail'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:boundaryEvent id="Event_15chubu" attachedToRef="Activity_1l1yjd4">
