    <bpmn:sequenceFlow id="Flow_0kv49tn" sourceRef="Gateway_0drqcrm" targetRef="Activity_0jisndd">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${checkStatus == 'haveSomeFilePaths'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1rdecav" sourceRef="Gateway_0drqcrm" targetRef="Activity_1gc4yf2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${checkStatus == 'allFilePathsBroken'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:callActivity id="Activity_1l1yjd4" name="delegate" calledElement="exportGpkgAdditionalContent">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in variables="all" />
        <camunda:out variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0cb7knp</bpmn:incoming>
      <bpmn:outgoing>Flow_1qjzaqq</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_1qjzaqq" sourceRef="Activity_1l1yjd4" targetRef="Activity_1gc4yf2" />
    <bpmn:sequenceFlow id="Flow_09rpgsg" sourceRef="Activity_1d235kx" targetRef="Gateway_1g861nn" />
    <bpmn:serviceTask id="Activity_1d235kx" name="save report" camunda:delegateExpression="${saveRastersReportAfterGdal}">
