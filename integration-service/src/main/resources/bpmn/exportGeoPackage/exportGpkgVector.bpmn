    <bpmn:sequenceFlow id="Flow_0cv29tp" sourceRef="Gateway_0nu0lss" targetRef="Activity_0f08ord">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${checkStatus == 'geoWrapperDone'}</bpmn:conditionExpression>
