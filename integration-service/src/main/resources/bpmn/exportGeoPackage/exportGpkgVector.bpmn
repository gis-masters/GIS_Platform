      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${checkStatus == 'someResourcesAvailable'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0wvjidj" sourceRef="Gateway_0ydy19e" targetRef="Activity_1gii0fq">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${checkStatus == 'allResourcesUnavailable'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:callActivity id="Activity_16ebi7u" name="delegate" calledElement="exportGpkgAdditionalContent">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
