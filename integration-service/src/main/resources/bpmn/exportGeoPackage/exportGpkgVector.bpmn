  <bpmn:process id="exportGpkgVector" name="Export Gpkg Vector" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_0liup9u</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_0f08ord" name="Get info from geoserver" camunda:asyncBefore="true" camunda:asyncAfter="true" camunda:delegateExpression="${askGeoserverAboutStylesAndSvg}">
      <bpmn:documentation>add style data in gpkg and forget it</bpmn:documentation>
      <bpmn:incoming>Flow_0cv29tp</bpmn:incoming>
      <bpmn:outgoing>Flow_05nbbmi</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_1jzf4l9" name="Get GPKG from geo-wrapper" camunda:delegateExpression="${askGeoWrapperCreateGpkg}">
      <bpmn:incoming>Flow_03l4y9q</bpmn:incoming>
      <bpmn:outgoing>Flow_1ba461s</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:receiveTask id="Activity_02xob25" name="Catch Event&#10;Update Process and go next" messageRef="Message_0fdq896">
      <bpmn:documentation>add layer data in gpkg and forget it</bpmn:documentation>
      <bpmn:incoming>Flow_1ba461s</bpmn:incoming>
      <bpmn:outgoing>Flow_0ixczad</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:serviceTask id="Activity_1v5uqhq" name="Ask data-service check resources" camunda:asyncBefore="true" camunda:delegateExpression="${askVectorTableAvailability}">
      <bpmn:incoming>Flow_00xi4ff</bpmn:incoming>
      <bpmn:incoming>Flow_0liup9u</bpmn:incoming>
      <bpmn:outgoing>Flow_0zgp8bj</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Event_0hmrgoo">
      <bpmn:incoming>Flow_0v0s1er</bpmn:incoming>
      <bpmn:outgoing>Flow_00xi4ff</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_0rms917">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Activity_00krva7" name="Update Table Report" camunda:asyncBefore="true" camunda:asyncAfter="true" camunda:delegateExpression="${updateTableReport}">
      <bpmn:documentation>need to update report</bpmn:documentation>
      <bpmn:incoming>Flow_0ixczad</bpmn:incoming>
      <bpmn:outgoing>Flow_18nqt4y</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Event_0vl19wb" name="Wait 5 min" camunda:asyncBefore="true" camunda:asyncAfter="true" attachedToRef="Activity_02xob25">
      <bpmn:outgoing>Flow_0tk1snq</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1gndsb4">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Event_00xq805" attachedToRef="Activity_1v5uqhq">
      <bpmn:outgoing>Flow_0v0s1er</bpmn:outgoing>
