    <bpmn:sequenceFlow id="Flow_0eft6bb" sourceRef="Gateway_0nu0lss" targetRef="Activity_1gii0fq">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${checkStatus == 'geoWrapperError'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_05nbbmi" sourceRef="Activity_0f08ord" targetRef="Activity_16ebi7u" />
