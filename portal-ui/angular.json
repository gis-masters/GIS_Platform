{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "gis-portal": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "prefix": "crg",
      "schematics": {},
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/gis-portal",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "src/tsconfig.app.json",

            "optimization": true,
            "outputHashing": "all",
            "sourceMap": false,
            "extractLicenses": true,
            "buildOptimizer": false,
            "vendorChunk": true,
            "aot": false,
            "extractCss": true,
            "namedChunks": false,

            "lazyModules": [
              "./src/app/components/header/header@conv.module",
              "./src/app/components/header/header@simf.module",
              "./src/app/components/home/home@conv.module",
              "./src/app/components/home/home@simf.module",
              "./src/app/components/workspace-header/workspace-header@conv.module",
              "./src/app/components/workspace-header/workspace-header@simf.module"
            ],

            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "./node_modules/bootstrap/dist/css/bootstrap.min.css",
              "./node_modules/@angular/material/prebuilt-themes/indigo-pink.css",
              "./node_modules/primeng/resources/themes/nova-light/theme.css",
              "./node_modules/primeng/resources/primeng.min.css",
              "./node_modules/primeicons/primeicons.css",
              "./node_modules/primeflex/primeflex.css",
              "src/styles.css"
            ],
            "scripts": []
          },
          "configurations": {
            "convProduction": {
              "fileReplacements": [{
                "replace": "src/assets/config/environment.json",
                "with": "src/assets/config/environment.convProd.json"
              }]
            },
            "convTest": {
              "fileReplacements": [{
                "replace": "src/assets/config/environment.json",
                "with": "src/assets/config/environment.convTest.json"
              }]
            },
            "convStaging": {
              "fileReplacements": [{
                "replace": "src/assets/config/environment.json",
                "with": "src/assets/config/environment.convStaging.json"
              }]
            },
            "convDev": {
              "fileReplacements": [{
                "replace": "src/assets/config/environment.json",
                "with": "src/assets/config/environment.convDev.json"
              }],
              "optimization": false,
              "sourceMap": true,
              "aot": false,
              "buildOptimizer": false,
              "extractCss": false
            },
            "simfProduction": {
              "fileReplacements": [{
                "replace": "src/assets/config/environment.json",
                "with": "src/assets/config/environment.simfProd.json"
              }]
            },
            "simfTest": {
              "fileReplacements": [{
                "replace": "src/assets/config/environment.json",
                "with": "src/assets/config/environment.simfTest.json"
              }]
            },
            "simfStaging": {
              "fileReplacements": [{
                "replace": "src/assets/config/environment.json",
                "with": "src/assets/config/environment.simfStaging.json"
              }]
            },
            "simfDev": {
              "fileReplacements": [{
                "replace": "src/assets/config/environment.json",
                "with": "src/assets/config/environment.simfDev.json"
              }],
              "optimization": false,
              "sourceMap": true,
              "aot": false,
              "buildOptimizer": false,
              "extractCss": false
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "browserTarget": "gis-portal:build"
          },
          "configurations": {
            "convProduction": {
              "browserTarget": "gis-portal:build:convProduction"
            },
            "convStaging": {
              "browserTarget": "gis-portal:build:convStaging"
            },
            "convTest": {
              "browserTarget": "gis-portal:build:convTest"
            },
            "convDev": {
              "browserTarget": "gis-portal:build:convDev"
            },
            "simfProduction": {
              "browserTarget": "gis-portal:build:simfProduction"
            },
            "simfStaging": {
              "browserTarget": "gis-portal:build:simfStaging"
            },
            "simfTest": {
              "browserTarget": "gis-portal:build:simfTest"
            },
            "simfDev": {
              "browserTarget": "gis-portal:build:simfDev"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "gis-portal:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "codeCoverage": true,
            "main": "src/test.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "src/tsconfig.spec.json",
            "karmaConfig": "src/karma.conf.js",
            "styles": [
              "./node_modules/@angular/material/prebuilt-themes/pink-bluegrey.css",
              "src/styles.css"
            ],
            "scripts": [],
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ]
          }
        },
        "lint": {
          "builder": "@angular-devkit/build-angular:tslint",
          "options": {
            "tsConfig": [
              "src/tsconfig.app.json",
              "src/tsconfig.spec.json"
            ],
            "exclude": [
              "**/node_modules/**"
            ]
          }
        }
      }
    },
    "gis-portal-e2e": {
      "root": "e2e/",
      "projectType": "application",
      "prefix": "",
      "architect": {
        "e2e": {
          "builder": "@angular-devkit/build-angular:protractor",
          "options": {
            "protractorConfig": "e2e/protractor.conf.js",
            "devServerTarget": "gis-portal:serve"
          },
          "configurations": {
            "production": {
              "devServerTarget": "gis-portal:serve:production"
            }
          }
        },
        "lint": {
          "builder": "@angular-devkit/build-angular:tslint",
          "options": {
            "tsConfig": "e2e/tsconfig.e2e.json",
            "exclude": [
              "**/node_modules/**"
            ]
          }
        }
      }
    }
  },
  "defaultProject": "gis-portal"
}
