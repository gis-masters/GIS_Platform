{
  "name": "gis-portal",
  "version": "0.0.62",
  "private": true,
  "scripts": {
    "postinstall": "cd .. && husky install portal-ui/.husky",
    "start": "ng serve -c dev --disable-host-check --host \"0.0.0.0\"",
    "start:min": "ng serve --disable-host-check --host \"0.0.0.0\"",
    "build": "npm run build-storybook && ng build",
    "lint": "gherkin-lint && eslint ./src/ && stylelint ./src/**/*.*css",
    "lint:fix": "prettier --write ./src/**/*.{css,scss,ts,tsx} && gherkin-lint && eslint ./src/ --fix && stylelint ./src/**/*.*css --fix",
    "storybook": "start-storybook -s ./src -p 6006",
    "build-storybook": "build-storybook -o ./bl",
    "wdio": "wdio --autoCompileOpts.tsNodeOpts.project=tests/tsconfig.json",
    "test": "jest",
    "test:unit": "npm test",
    "test:ui": "rm -rf tests/_screens/.tmp/* && npm run wdio -- run tests/ui/wdio.conf.ts",
    "test:ui:dev": "rm -rf tests/_screens/.tmp/* && npm run wdio -- run tests/ui/wdio.dev.conf.ts",
    "test:ui:dev:wip": "npm run test:ui:dev -- --cucumberOpts.tagExpression=\"@wip\"",
    "test:e2e": "rm -rf tests/_screens/.tmp/* && npm run wdio -- run tests/e2e/wdio.conf.ts",
    "test:e2e:dev": "rm -rf tests/_screens/.tmp/* && npm run wdio -- run tests/e2e/wdio.dev.conf.ts",
    "test:e2e:dev:wip": "npm run test:e2e:dev -- --cucumberOpts.tagExpression=\"@wip\"",
    "test:e2e:devLocal": "rm -rf tests/_screens/.tmp/* && npm run wdio -- run tests/e2e/wdio.devLocal.conf.ts",
    "test:e2e:devLocal:wip": "npm run test:e2e:devLocal -- --cucumberOpts.tagExpression=\"@wip\"",
    "test:stage58": "rm -rf tests/_screens/.tmp/* && npm run wdio -- run tests/deployment/stage58/wdio.conf.ts",
    "test:stage98": "rm -rf tests/_screens/.tmp/* && npm run wdio -- run tests/deployment/stage98/wdio.conf.ts",
    "test:stage172": "rm -rf tests/_screens/.tmp/* && npm run wdio -- run tests/deployment/stage172/wdio.conf.ts",
    "test:hermione": "TS_NODE_PROJECT=./hermione/tsconfig.json hermione --require ts-node/register --set ui"
  },
