{
  "*.{js,ts,tsx}": [
    "eslint --fix",
    "prettier --write"
  ],
  "*.md": [
    "prettier --write --parser markdown"
  ],
  "*.json": [
    "prettier --write --parser json"
  ],
  "../data-service/src/main/resources/system_schemas/**/*.json": [
    "prettier --write --parser json"
  ],
  "*.{css,scss}": [
    "prettier --write",
    "stylelint --fix"
  ],
  "*.feature": [
    "gherkin-lint"
  ]
}
